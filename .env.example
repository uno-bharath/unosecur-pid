DATABASE_URL=postgresql://enterprise:enterprise_dev@localhost:5432/enterprise_ai
REDIS_URL=redis://:redis_dev@localhost:6379
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b-instruct-q4_K_M
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional UnoSecur tenant evidence source. Keep real values only in .env.local
# or a Kubernetes Secret; never commit credentials.
CLICKHOUSE_ENABLED=false
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USERNAME=pid_readonly
CLICKHOUSE_PASSWORD=replace_locally
CLICKHOUSE_DATABASE=unosecur_organization_replace_tenant_uno_id
CLICKHOUSE_REQUEST_TIMEOUT_MS=10000
CLICKHOUSE_REFRESH_INTERVAL_SECONDS=15
CLICKHOUSE_SECURE=false

# Optional multi-cluster Kubernetes evidence. Use context names from the local
# kubeconfig and explicitly allowlist non-production clusters.
KUBERNETES_ENABLED=false
KUBERNETES_KUBECONFIG=
KUBERNETES_CONTEXTS=gke-nonprod,eks-nonprod
KUBERNETES_WATCH_ENABLED=true
KUBERNETES_WATCH_RECONNECT_SECONDS=5
KUBERNETES_RESOURCE_LIMIT=5000
KUBERNETES_INCLUDE_NAMESPACES=
KUBERNETES_EXCLUDE_NAMESPACES=kube-system,kube-public,kube-node-lease
KUBERNETES_ALLOW_PRODUCTION=false
