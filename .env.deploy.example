POSTGRES_DB=unosecur_pid
POSTGRES_USER=unosecur_pid
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace_with_a_strong_password
REDIS_PORT=6379

NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_a_strong_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

API_PORT=4000
WEB_PORT=3000
PUBLIC_API_URL=http://localhost:4000/api
WEB_ORIGIN=http://localhost:3000

# Ollama runs on the host and is optional. PID uses deterministic fallback
# narratives when it is unavailable.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
