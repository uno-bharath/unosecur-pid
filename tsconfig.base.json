{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@enterprise/ui/*": ["packages/ui/*"],
      "@enterprise/types/*": ["packages/types/*"],
      "@enterprise/sdk/*": ["packages/sdk/*"],
      "@enterprise/config/*": ["packages/config/*"]
    }
  }
}
